    Text(ID_MOM_SPELL_DESC_20);
    Button(ID_MOM_SPELL_CLOSE) {
        Kill();
        Message(player[0], 'MomSpellHub_life');
    }
    Button(ID_MOM_SPELL_BTN_1) {
        if (MomMagicCur[player[0]] >= 30) {
            MomCastSpell(player[0], 20);
        } else {
            Message(player[0], 'MomNotEnoughMana');
        }
        Kill();
    }
}

