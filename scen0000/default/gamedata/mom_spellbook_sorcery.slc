// ===== SORCERY SPELLBOOK HUB =====
alertbox 'MomSpellHub_sorcery' {
    Show();
    Text(ID_MOM_SPELLHUB_SORCERY);

    Button(ID_MOM_SPELL_CLOSE) {
        Kill();
    }
    // Common (5 spells) -- requires rung >= 1
    Button(ID_MOM_SPELLHUB_BTN_COMMON) {
        Kill();
        if (MomSphereRung[player[0]] >= 1) {
            Message(player[0], 'MomSpell_sorcery_COMMON_1');
        } else {
            Message(player[0], 'MomSpellLocked');
        }
    }
    // Uncommon (7 spells) -- requires rung >= 1
    Button(ID_MOM_SPELLHUB_BTN_UNCOMMON) {
        Kill();
        if (MomSphereRung[player[0]] >= 1) {
            Message(player[0], 'MomSpell_sorcery_UNCOMMON_1');
        } else {
            Message(player[0], 'MomSpellLocked');
        }
    }
    // Rare (6 spells) -- requires rung >= 2
    Button(ID_MOM_SPELLHUB_BTN_RARE) {
        Kill();
        if (MomSphereRung[player[0]] >= 2) {
            Message(player[0], 'MomSpell_sorcery_RARE_1');
        } else {
            Message(player[0], 'MomSpellLocked');
        }
    }
    // Very Rare (8 spells) -- requires rung >= 4
    Button(ID_MOM_SPELLHUB_BTN_VERY_RARE) {
        Kill();
        if (MomSphereRung[player[0]] >= 4) {
            Message(player[0], 'MomSpell_sorcery_VERY_RARE_1');
        } else {
            Message(player[0], 'MomSpellLocked');
        }
    }
}

