// Confirmation for Spell Ward
alertbox 'MomSpellConfirm_86' {
    Show();
    Text(ID_MOM_SPELL_DESC_86);
    Button(ID_MOM_SPELL_CLOSE) {
        Kill();
        Message(player[0], 'MomSpellHub_sorcery');
    }
    Button(ID_MOM_SPELL_BTN_1) {
        if (MomMagicCur[player[0]] >= 70) {
            MomCastSpell(player[0], 86);
        } else {
            Message(player[0], 'MomNotEnoughMana');
        }
        Kill();
    }
}

