                if (wild < 2) { return UnitDB(UNIT_BEHEMOTH); }
                if (wild < 3) { return UnitDB(UNIT_BONE_GOLEM); }
                if (wild < 4) { return UnitDB(UNIT_COCKATRICE); }
                if (wild < 5) { return UnitDB(UNIT_CRUSADER); }
                if (wild < 6) { return UnitDB(UNIT_CRYSTAL_GOLEM); }
                if (wild < 7) { return UnitDB(UNIT_DEMON); }
                if (wild < 8) { return UnitDB(UNIT_DRUID); }
                if (wild < 9) { return UnitDB(UNIT_GUARDIAN_SPIRIT); }
                if (wild < 10) { return UnitDB(UNIT_PEGASUS); }
                if (wild < 11) { return UnitDB(UNIT_PHANTOM_WARRIORS); }
