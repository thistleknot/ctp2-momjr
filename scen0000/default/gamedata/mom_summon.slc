                if (wild < 13) { return UnitDB(UNIT_GUARDIAN_SPIRIT); }
                if (wild < 14) { return UnitDB(UNIT_PEGASUS); }
                if (wild < 15) { return UnitDB(UNIT_PHANTOM_WARRIORS); }
                if (wild < 16) { return UnitDB(UNIT_SKELETONS); }
                if (wild < 17) { return UnitDB(UNIT_STORM_DRAKE); }
                if (wild < 18) { return UnitDB(UNIT_STORM_GIANT); }
                if (wild < 19) { return UnitDB(UNIT_TEMPLAR); }
                if (wild < 20) { return UnitDB(UNIT_TREANT); }
                if (wild < 21) { return UnitDB(UNIT_UNDEAD_DRAGON); }
                if (wild < 22) { return UnitDB(UNIT_UNICORN); }
                if (wild < 23) { return UnitDB(UNIT_VAMPIRE); }
                if (wild < 24) { return UnitDB(UNIT_WARBEARS); }
                if (wild < 25) { return UnitDB(UNIT_WRAITH); }
