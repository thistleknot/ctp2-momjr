                if (wild < 7) { return UnitDB(UNIT_DEMON); }
                if (wild < 8) { return UnitDB(UNIT_DJINN); }
                if (wild < 9) { return UnitDB(UNIT_DRACOLICH); }
                if (wild < 10) { return UnitDB(UNIT_DRUID); }
