            MomSummonChoice[player[0]] = UnitDB(UNIT_ORC);
        } else {
            Message(player[0], 'MomSummonNoMana');
        }
        Kill();
    }
    Button(ID_MOM_SPELL_BTN_2) {
        if (MomSummonPrep[player[0]] > 0) {
            Message(player[0], 'MomSummonBusy');
        } elseif (MomMagicCur[player[0]] >= ((45 + 30 * 1) * MomSummonCivPct[player[0]]) / 100) {
            MomSummonChoice[player[0]] = UnitDB(UNIT_HELL_HOUNDS);
        } else {
            Message(player[0], 'MomSummonNoMana');
        }
        Kill();
    }
    Button(ID_MOM_SPELL_BTN_1) {
        if (MomSummonPrep[player[0]] > 0) {
            Message(player[0], 'MomSummonBusy');
        } elseif (MomMagicCur[player[0]] >= ((45 + 30 * 1) * MomSummonCivPct[player[0]]) / 100) {
            MomSummonChoice[player[0]] = UnitDB(UNIT_GOBLIN);
        } else {
            Message(player[0], 'MomSummonNoMana');
        }
        Kill();
    }
