// mom_summon.slc -- GENERATED by tools/ctp2_generator.py. DO NOT HAND-EDIT.
//
// Makes the six-rung sphere ladder govern what 75 mana buys. Before this,
// MomSummonOrderTick held five CONSTANTS -- Nature always summoned Warbears,
// the CHEAPEST of its units, at every rung -- so researching NATURE_ADEPT
// through NATURE_MASTER changed nothing and 12 of Nature's creatures were
// unreachable by summoning (reported in play 2026-07-28).
//
// CONSTRAINTS honoured here (slic-two-crash-classes):
//   * both bodies are FLAT -- neither calls a user function at all.
//   * MomSummonRoll RETURNS an index; the caller does the spawning, so the
//     handler's single call level is not already spent when it spawns.
//   * every comparison goes through AdvanceDB() / UnitDB(), never a bare ident.
//
// Every ident below was filtered against the live generated DB at emit time.

// Highest ladder rung each player has reached, 0 = none. Written here and
// read by MomSummonRoll and mom_ai_magic.slc.
int_t MomSphereRung[31];

// Rung attainment. A separate handler from mom_city_effects.slc's milestone
// blessings on purpose: that one fires once per sphere root, this one must see
// every rung. value[0] IS the granted advance index -- GrantAdvance does NOT
// populate advance[], and assigning value[0] into it does not make it readable
// (measured 2026-07-25).
HandleEvent(GrantAdvance) 'MomSphereRungTick' post {
    int_t p;

    p = player[0];
    if (p >= 1 && p <= 5 && value[0] != 0) {
        // LIFE (player 1)
        if (MomSphere[p] == 1 && value[0] == AdvanceDB(ADVANCE_LIFE_MAGIC) && MomSphereRung[p] < 1) { MomSphereRung[p] = 1; }
        if (MomSphere[p] == 1 && value[0] == AdvanceDB(ADVANCE_LIFE_LORE) && MomSphereRung[p] < 1) { MomSphereRung[p] = 1; }
        if (MomSphere[p] == 1 && value[0] == AdvanceDB(ADVANCE_LIFE_ADEPT) && MomSphereRung[p] < 2) { MomSphereRung[p] = 2; }
        if (MomSphere[p] == 1 && value[0] == AdvanceDB(ADVANCE_LIFE_MAGE) && MomSphereRung[p] < 3) { MomSphereRung[p] = 3; }
        if (MomSphere[p] == 1 && value[0] == AdvanceDB(ADVANCE_LIFE_WIZARD) && MomSphereRung[p] < 4) { MomSphereRung[p] = 4; }
        if (MomSphere[p] == 1 && value[0] == AdvanceDB(ADVANCE_LIFE_MASTER) && MomSphereRung[p] < 5) { MomSphereRung[p] = 5; }
        // NATURE (player 2)
        if (MomSphere[p] == 2 && value[0] == AdvanceDB(ADVANCE_NATURE_MAGIC) && MomSphereRung[p] < 1) { MomSphereRung[p] = 1; }
        if (MomSphere[p] == 2 && value[0] == AdvanceDB(ADVANCE_NATURE_LORE) && MomSphereRung[p] < 1) { MomSphereRung[p] = 1; }
        if (MomSphere[p] == 2 && value[0] == AdvanceDB(ADVANCE_NATURE_ADEPT) && MomSphereRung[p] < 2) { MomSphereRung[p] = 2; }
        if (MomSphere[p] == 2 && value[0] == AdvanceDB(ADVANCE_NATURE_MAGE) && MomSphereRung[p] < 3) { MomSphereRung[p] = 3; }
        if (MomSphere[p] == 2 && value[0] == AdvanceDB(ADVANCE_NATURE_WIZARD) && MomSphereRung[p] < 4) { MomSphereRung[p] = 4; }
        if (MomSphere[p] == 2 && value[0] == AdvanceDB(ADVANCE_NATURE_MASTER) && MomSphereRung[p] < 5) { MomSphereRung[p] = 5; }
        // SORCERY (player 3)
        if (MomSphere[p] == 3 && value[0] == AdvanceDB(ADVANCE_SORCERY) && MomSphereRung[p] < 1) { MomSphereRung[p] = 1; }
        if (MomSphere[p] == 3 && value[0] == AdvanceDB(ADVANCE_SORCEROUS_LORE) && MomSphereRung[p] < 1) { MomSphereRung[p] = 1; }
        if (MomSphere[p] == 3 && value[0] == AdvanceDB(ADVANCE_SORCERY_ADEPT) && MomSphereRung[p] < 2) { MomSphereRung[p] = 2; }
        if (MomSphere[p] == 3 && value[0] == AdvanceDB(ADVANCE_SORCERY_MAGE) && MomSphereRung[p] < 3) { MomSphereRung[p] = 3; }
        if (MomSphere[p] == 3 && value[0] == AdvanceDB(ADVANCE_SORCERY_WIZARD) && MomSphereRung[p] < 4) { MomSphereRung[p] = 4; }
        if (MomSphere[p] == 3 && value[0] == AdvanceDB(ADVANCE_SORCERY_MASTER) && MomSphereRung[p] < 5) { MomSphereRung[p] = 5; }
        // DEATH (player 4)
        if (MomSphere[p] == 4 && value[0] == AdvanceDB(ADVANCE_DEATH_MAGIC) && MomSphereRung[p] < 1) { MomSphereRung[p] = 1; }
        if (MomSphere[p] == 4 && value[0] == AdvanceDB(ADVANCE_DEATH_LORE) && MomSphereRung[p] < 1) { MomSphereRung[p] = 1; }
        if (MomSphere[p] == 4 && value[0] == AdvanceDB(ADVANCE_DEATH_ADEPT) && MomSphereRung[p] < 2) { MomSphereRung[p] = 2; }
        if (MomSphere[p] == 4 && value[0] == AdvanceDB(ADVANCE_DEATH_MAGE) && MomSphereRung[p] < 3) { MomSphereRung[p] = 3; }
        if (MomSphere[p] == 4 && value[0] == AdvanceDB(ADVANCE_DEATH_WIZARD) && MomSphereRung[p] < 4) { MomSphereRung[p] = 4; }
        if (MomSphere[p] == 4 && value[0] == AdvanceDB(ADVANCE_DEATH_MASTER) && MomSphereRung[p] < 5) { MomSphereRung[p] = 5; }
        // CHAOS (player 5)
        if (MomSphere[p] == 5 && value[0] == AdvanceDB(ADVANCE_CHAOS_MAGIC) && MomSphereRung[p] < 1) { MomSphereRung[p] = 1; }
        if (MomSphere[p] == 5 && value[0] == AdvanceDB(ADVANCE_CHAOS_LORE) && MomSphereRung[p] < 1) { MomSphereRung[p] = 1; }
        if (MomSphere[p] == 5 && value[0] == AdvanceDB(ADVANCE_CHAOS_ADEPT) && MomSphereRung[p] < 2) { MomSphereRung[p] = 2; }
        if (MomSphere[p] == 5 && value[0] == AdvanceDB(ADVANCE_CHAOS_MAGE) && MomSphereRung[p] < 3) { MomSphereRung[p] = 3; }
        if (MomSphere[p] == 5 && value[0] == AdvanceDB(ADVANCE_CHAOS_WIZARD) && MomSphereRung[p] < 4) { MomSphereRung[p] = 4; }
        if (MomSphere[p] == 5 && value[0] == AdvanceDB(ADVANCE_CHAOS_MASTER) && MomSphereRung[p] < 5) { MomSphereRung[p] = 5; }
    }
}

// The weighted roll. Bands are cut from the COUNT of unlocked rungs, not from
// hardcoded percentages, so adding a rung cannot leave a dead band: the newest
// unlocked rung takes the widest slice and every older rung keeps a floor.
// Returns 0 when nothing is unlocked yet -- the caller must treat 0 as 'no
// summon' and leave the pool alone.
int_f MomSummonRoll(int_t p)
{
    int_t r;
    int_t roll;
    int_t wild;

    r = MomSphereRung[p];
    // NO FLOOR. Rung 0 means 'this tribe has learned no magic of its own
    // sphere', and it must fall through every band below so this function
    // returns 0 -- which every caller already reads as 'no summon' and
    // which leaves the pool undebited (mom_msg.slc gates the 75 on
    // summonPick != 0, mom_ai_magic.slc on pick != 0).
    //
    // A `if (r < 1) { r = 1; }` FLOOR LIVED HERE from v3.2.0 until
    // 2026-08-02 and was the whole reason a tribe's army was creatures it
    // could never have built. A Warbears costs 1970 science to BUILD
    // (ADVANCE_NATURE_LORE) and, with the floor, 0 science to SUMMON: every
    // tribe had rung-1 summoning from turn one and the summon path skipped
    // the tech tree entirely.
    //
    // The floor was justified as 'a tribe that starts holding its sphere
    // root never fires the GrantAdvance that would raise it off 0'. That
    // premise is FALSE in this scenario -- nothing anywhere grants a
    // *_MAGIC or *_LORE advance and there is no starting-advance mechanism,
    // so no tribe ever starts holding its root. It guarded a case that does
    // not exist and cost a whole tech gate. Do not restore it; if a
    // starting-advance mechanism is ever added, seed MomSphereRung[] there
    // rather than flooring here (gate_mana_upkeep.py assertion 12).
    roll = Random(100);

    // LIFE (player 1)
    if (MomSphere[p] == 1) {
        if (r == 5) {
            if (roll < 16) { return UnitDB(UNIT_GUARDIAN_SPIRIT); }
            if (roll < 32) { return UnitDB(UNIT_UNICORN); }
            if (roll < 48) { return UnitDB(UNIT_PEGASUS); }
            if (roll < 100) { return UnitDB(UNIT_ARCHANGEL); }
        }
        if (r == 4) {
            if (roll < 25) { return UnitDB(UNIT_GUARDIAN_SPIRIT); }
            if (roll < 50) { return UnitDB(UNIT_UNICORN); }
            if (roll < 100) { return UnitDB(UNIT_PEGASUS); }
        }
        if (r == 3) {
            if (roll < 25) { return UnitDB(UNIT_GUARDIAN_SPIRIT); }
            if (roll < 50) { return UnitDB(UNIT_UNICORN); }
            if (roll < 100) { return UnitDB(UNIT_PEGASUS); }
        }
        if (r == 2) {
            if (roll < 50) { return UnitDB(UNIT_GUARDIAN_SPIRIT); }
            if (roll < 100) { return UnitDB(UNIT_UNICORN); }
        }
        if (r == 1) {
            if (roll < 100) { return UnitDB(UNIT_GUARDIAN_SPIRIT); }
        }
    }

    // NATURE (player 2)
    if (MomSphere[p] == 2) {
        if (r == 5) {
            if (roll < 16) { return UnitDB(UNIT_WARBEARS); }
            if (roll < 32) { return UnitDB(UNIT_COCKATRICE); }
            if (roll < 48) { return UnitDB(UNIT_BEHEMOTH); }
            if (roll < 100) { return UnitDB(UNIT_GREAT_WYRM); }
        }
        if (r == 4) {
            if (roll < 25) { return UnitDB(UNIT_WARBEARS); }
            if (roll < 50) { return UnitDB(UNIT_COCKATRICE); }
            if (roll < 100) { return UnitDB(UNIT_BEHEMOTH); }
        }
        if (r == 3) {
            if (roll < 25) { return UnitDB(UNIT_WARBEARS); }
            if (roll < 50) { return UnitDB(UNIT_COCKATRICE); }
            if (roll < 100) { return UnitDB(UNIT_BEHEMOTH); }
        }
        if (r == 2) {
            if (roll < 50) { return UnitDB(UNIT_WARBEARS); }
            if (roll < 100) { return UnitDB(UNIT_COCKATRICE); }
        }
        if (r == 1) {
            if (roll < 100) { return UnitDB(UNIT_WARBEARS); }
        }
    }

    // SORCERY (player 3)
    if (MomSphere[p] == 3) {
        if (r == 5) {
            if (roll < 16) { return UnitDB(UNIT_PHANTOM_WARRIORS); }
            if (roll < 32) { return UnitDB(UNIT_AIR_ELEMENTAL); }
            if (roll < 48) { return UnitDB(UNIT_STORM_GIANT); }
            if (roll < 100) { return UnitDB(UNIT_STORM_DRAKE); }
        }
        if (r == 4) {
            if (roll < 25) { return UnitDB(UNIT_PHANTOM_WARRIORS); }
            if (roll < 50) { return UnitDB(UNIT_AIR_ELEMENTAL); }
            if (roll < 100) { return UnitDB(UNIT_STORM_GIANT); }
        }
        if (r == 3) {
            if (roll < 25) { return UnitDB(UNIT_PHANTOM_WARRIORS); }
            if (roll < 50) { return UnitDB(UNIT_AIR_ELEMENTAL); }
            if (roll < 100) { return UnitDB(UNIT_STORM_GIANT); }
        }
        if (r == 2) {
            if (roll < 50) { return UnitDB(UNIT_PHANTOM_WARRIORS); }
            if (roll < 100) { return UnitDB(UNIT_AIR_ELEMENTAL); }
        }
        if (r == 1) {
            if (roll < 100) { return UnitDB(UNIT_PHANTOM_WARRIORS); }
        }
    }

    // DEATH (player 4)
    if (MomSphere[p] == 4) {
        if (r == 5) {
            if (roll < 6) { return UnitDB(UNIT_SKELETONS); }
            if (roll < 12) { return UnitDB(UNIT_ZOMBIES); }
            if (roll < 24) { return UnitDB(UNIT_WRAITH); }
            if (roll < 36) { return UnitDB(UNIT_DEMON); }
            if (roll < 48) { return UnitDB(UNIT_DRACOLICH); }
            if (roll < 100) { return UnitDB(UNIT_UNDEAD_DRAGON); }
        }
        if (r == 4) {
            if (roll < 8) { return UnitDB(UNIT_SKELETONS); }
            if (roll < 16) { return UnitDB(UNIT_ZOMBIES); }
            if (roll < 32) { return UnitDB(UNIT_WRAITH); }
            if (roll < 48) { return UnitDB(UNIT_DEMON); }
            if (roll < 100) { return UnitDB(UNIT_DRACOLICH); }
        }
        if (r == 3) {
            if (roll < 12) { return UnitDB(UNIT_SKELETONS); }
            if (roll < 25) { return UnitDB(UNIT_ZOMBIES); }
            if (roll < 50) { return UnitDB(UNIT_WRAITH); }
            if (roll < 100) { return UnitDB(UNIT_DEMON); }
        }
        if (r == 2) {
            if (roll < 25) { return UnitDB(UNIT_SKELETONS); }
            if (roll < 50) { return UnitDB(UNIT_ZOMBIES); }
            if (roll < 100) { return UnitDB(UNIT_WRAITH); }
        }
        if (r == 1) {
            if (roll < 50) { return UnitDB(UNIT_SKELETONS); }
            if (roll < 100) { return UnitDB(UNIT_ZOMBIES); }
        }
    }

    // CHAOS (player 5)
    if (MomSphere[p] == 5) {
        wild = Random(100);
        if (wild < 15) {
            if (r == 5) {
                wild = Random(18);
                if (wild < 1) { return UnitDB(UNIT_AIR_ELEMENTAL); }
                if (wild < 2) { return UnitDB(UNIT_ARCHANGEL); }
                if (wild < 3) { return UnitDB(UNIT_BEHEMOTH); }
                if (wild < 4) { return UnitDB(UNIT_COCKATRICE); }
                if (wild < 5) { return UnitDB(UNIT_DEMON); }
                if (wild < 6) { return UnitDB(UNIT_DRACOLICH); }
                if (wild < 7) { return UnitDB(UNIT_GREAT_WYRM); }
                if (wild < 8) { return UnitDB(UNIT_GUARDIAN_SPIRIT); }
                if (wild < 9) { return UnitDB(UNIT_PEGASUS); }
                if (wild < 10) { return UnitDB(UNIT_PHANTOM_WARRIORS); }
                if (wild < 11) { return UnitDB(UNIT_SKELETONS); }
                if (wild < 12) { return UnitDB(UNIT_STORM_DRAKE); }
                if (wild < 13) { return UnitDB(UNIT_STORM_GIANT); }
                if (wild < 14) { return UnitDB(UNIT_UNDEAD_DRAGON); }
                if (wild < 15) { return UnitDB(UNIT_UNICORN); }
                if (wild < 16) { return UnitDB(UNIT_WARBEARS); }
                if (wild < 17) { return UnitDB(UNIT_WRAITH); }
                if (wild < 18) { return UnitDB(UNIT_ZOMBIES); }
            }
            if (r == 4) {
                wild = Random(14);
                if (wild < 1) { return UnitDB(UNIT_AIR_ELEMENTAL); }
                if (wild < 2) { return UnitDB(UNIT_BEHEMOTH); }
                if (wild < 3) { return UnitDB(UNIT_COCKATRICE); }
                if (wild < 4) { return UnitDB(UNIT_DEMON); }
                if (wild < 5) { return UnitDB(UNIT_DRACOLICH); }
                if (wild < 6) { return UnitDB(UNIT_GUARDIAN_SPIRIT); }
                if (wild < 7) { return UnitDB(UNIT_PEGASUS); }
                if (wild < 8) { return UnitDB(UNIT_PHANTOM_WARRIORS); }
                if (wild < 9) { return UnitDB(UNIT_SKELETONS); }
                if (wild < 10) { return UnitDB(UNIT_STORM_GIANT); }
                if (wild < 11) { return UnitDB(UNIT_UNICORN); }
                if (wild < 12) { return UnitDB(UNIT_WARBEARS); }
                if (wild < 13) { return UnitDB(UNIT_WRAITH); }
                if (wild < 14) { return UnitDB(UNIT_ZOMBIES); }
            }
            if (r == 3) {
                wild = Random(13);
                if (wild < 1) { return UnitDB(UNIT_AIR_ELEMENTAL); }
                if (wild < 2) { return UnitDB(UNIT_BEHEMOTH); }
                if (wild < 3) { return UnitDB(UNIT_COCKATRICE); }
                if (wild < 4) { return UnitDB(UNIT_DEMON); }
                if (wild < 5) { return UnitDB(UNIT_GUARDIAN_SPIRIT); }
                if (wild < 6) { return UnitDB(UNIT_PEGASUS); }
                if (wild < 7) { return UnitDB(UNIT_PHANTOM_WARRIORS); }
                if (wild < 8) { return UnitDB(UNIT_SKELETONS); }
                if (wild < 9) { return UnitDB(UNIT_STORM_GIANT); }
                if (wild < 10) { return UnitDB(UNIT_UNICORN); }
                if (wild < 11) { return UnitDB(UNIT_WARBEARS); }
                if (wild < 12) { return UnitDB(UNIT_WRAITH); }
                if (wild < 13) { return UnitDB(UNIT_ZOMBIES); }
            }
            if (r == 2) {
                wild = Random(9);
                if (wild < 1) { return UnitDB(UNIT_AIR_ELEMENTAL); }
                if (wild < 2) { return UnitDB(UNIT_COCKATRICE); }
                if (wild < 3) { return UnitDB(UNIT_GUARDIAN_SPIRIT); }
                if (wild < 4) { return UnitDB(UNIT_PHANTOM_WARRIORS); }
                if (wild < 5) { return UnitDB(UNIT_SKELETONS); }
                if (wild < 6) { return UnitDB(UNIT_UNICORN); }
                if (wild < 7) { return UnitDB(UNIT_WARBEARS); }
                if (wild < 8) { return UnitDB(UNIT_WRAITH); }
                if (wild < 9) { return UnitDB(UNIT_ZOMBIES); }
            }
            if (r == 1) {
                wild = Random(5);
                if (wild < 1) { return UnitDB(UNIT_GUARDIAN_SPIRIT); }
                if (wild < 2) { return UnitDB(UNIT_PHANTOM_WARRIORS); }
                if (wild < 3) { return UnitDB(UNIT_SKELETONS); }
                if (wild < 4) { return UnitDB(UNIT_WARBEARS); }
                if (wild < 5) { return UnitDB(UNIT_ZOMBIES); }
            }
        }
        if (r == 5) {
            if (roll < 16) { return UnitDB(UNIT_HELL_HOUNDS); }
            if (roll < 32) { return UnitDB(UNIT_GARGOYLE); }
            if (roll < 48) { return UnitDB(UNIT_EFREET); }
            if (roll < 100) { return UnitDB(UNIT_HYDRA); }
        }
        if (r == 4) {
            if (roll < 25) { return UnitDB(UNIT_HELL_HOUNDS); }
            if (roll < 50) { return UnitDB(UNIT_GARGOYLE); }
            if (roll < 100) { return UnitDB(UNIT_EFREET); }
        }
        if (r == 3) {
            if (roll < 25) { return UnitDB(UNIT_HELL_HOUNDS); }
            if (roll < 50) { return UnitDB(UNIT_GARGOYLE); }
            if (roll < 100) { return UnitDB(UNIT_EFREET); }
        }
        if (r == 2) {
            if (roll < 50) { return UnitDB(UNIT_HELL_HOUNDS); }
            if (roll < 100) { return UnitDB(UNIT_GARGOYLE); }
        }
        if (r == 1) {
            if (roll < 100) { return UnitDB(UNIT_HELL_HOUNDS); }
        }
    }

    return 0;
}

// Rung that owns each summonable creature -- the mana-upkeep rate table.
// GENERATED alongside the roll above from the same pools, so the rate a
// creature is charged can never drift from the rung it was rolled at.
int_f MomSummonRungOf(int_t unitType)
{
    if (unitType == UnitDB(UNIT_AIR_ELEMENTAL)) { return 2; }
    if (unitType == UnitDB(UNIT_ARCHANGEL)) { return 5; }
    if (unitType == UnitDB(UNIT_BEHEMOTH)) { return 3; }
    if (unitType == UnitDB(UNIT_COCKATRICE)) { return 2; }
    if (unitType == UnitDB(UNIT_DEMON)) { return 3; }
    if (unitType == UnitDB(UNIT_DRACOLICH)) { return 4; }
    if (unitType == UnitDB(UNIT_EFREET)) { return 3; }
    if (unitType == UnitDB(UNIT_GARGOYLE)) { return 2; }
    if (unitType == UnitDB(UNIT_GREAT_WYRM)) { return 5; }
    if (unitType == UnitDB(UNIT_GUARDIAN_SPIRIT)) { return 1; }
    if (unitType == UnitDB(UNIT_HELL_HOUNDS)) { return 1; }
    if (unitType == UnitDB(UNIT_HYDRA)) { return 5; }
    if (unitType == UnitDB(UNIT_PEGASUS)) { return 3; }
    if (unitType == UnitDB(UNIT_PHANTOM_WARRIORS)) { return 1; }
    if (unitType == UnitDB(UNIT_SKELETONS)) { return 1; }
    if (unitType == UnitDB(UNIT_STORM_DRAKE)) { return 5; }
    if (unitType == UnitDB(UNIT_STORM_GIANT)) { return 3; }
    if (unitType == UnitDB(UNIT_UNDEAD_DRAGON)) { return 5; }
    if (unitType == UnitDB(UNIT_UNICORN)) { return 2; }
    if (unitType == UnitDB(UNIT_WARBEARS)) { return 1; }
    if (unitType == UnitDB(UNIT_WRAITH)) { return 2; }
    if (unitType == UnitDB(UNIT_ZOMBIES)) { return 1; }
    return 0;
}
