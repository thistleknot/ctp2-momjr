        if (MomSphereRung[player[0]] >= 1) {
            Message(player[0], 'MomSpell_nature_RARE_1');
        } else {
            Message(player[0], 'MomSpellLocked');
        }
    }
    // Very Rare (8 spells) -- requires rung >= 1
    Button(ID_MOM_SPELLHUB_BTN_VERY_RARE) {
        Kill();
        if (MomSphereRung[player[0]] >= 1) {
            Message(player[0], 'MomSpell_nature_VERY_RARE_1');
        } else {
            Message(player[0], 'MomSpellLocked');
        }
    }
}

