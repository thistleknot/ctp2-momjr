    } elseif (spellId == 131) {
        // Great Drake (summon) - cost 180
        MomMagicCur[p] = MomMagicCur[p] - 180;
        GetCityByIndex(p, 0, tmpCity);
        CreateUnit(p, UnitDB(UNIT_GREAT_WYRM), tmpCity.location, 0);
        Message(p, 'MomSpellCast');
    } elseif (spellId == 132) {
        // Great Wasting (global_enchant) - cost 180
        MomMagicCur[p] = MomMagicCur[p] - 180;
        for (pi = 1; pi < 6; pi = pi + 1) {
            if (pi != p) {
                MomMagicCur[pi] = MomMagicCur[pi] - 30;
                if (MomMagicCur[pi] < 0) { MomMagicCur[pi] = 0; }
            }
        }
        Message(p, 'MomSpellCast');
    } elseif (spellId == 133) {
        // Hydra (summon) - cost 130
        MomMagicCur[p] = MomMagicCur[p] - 130;
        GetCityByIndex(p, 0, tmpCity);
        CreateUnit(p, UnitDB(UNIT_HYDRA), tmpCity.location, 0);
        Message(p, 'MomSpellCast');
    } elseif (spellId == 134) {
        // Meteor Storm (global_enchant) - cost 180
        MomMagicCur[p] = MomMagicCur[p] - 180;
        for (pi = 1; pi < 6; pi = pi + 1) {
            if (pi != p) {
                MomMagicCur[pi] = MomMagicCur[pi] - 20;
                if (MomMagicCur[pi] < 0) { MomMagicCur[pi] = 0; }
            }
        }
        Message(p, 'MomSpellCast');
    }
    return 1;
}

// Message segments for spell cast feedback
messagebox 'MomSpellCast' {
    Show();
    Text(ID_MOM_MSG_SPELL_CAST);
}

messagebox 'MomNotEnoughMana' {
    Show();
    Text(ID_MOM_MSG_NOT_ENOUGH_MANA);
}

messagebox 'MomSpellLocked' {
    Show();
    Text(ID_MOM_MSG_SPELL_LOCKED);
}

// Out-of-range feedback when no mage is close enough to an enemy city
messagebox 'MomNoTargetInRange' {
    Show();
    Text(ID_MOM_MSG_NO_TARGET_IN_RANGE);
}

// Feedback when the signature unit is not in range for a bound spell
messagebox 'MomNoRequiredUnit' {
    Show();
    Text(ID_MOM_MSG_NO_REQUIRED_UNIT);
}

// Feedback when a target unit resists or is immune to a kill spell
messagebox 'MomSpellResisted' {
    Show();
    Text(ID_MOM_MSG_SPELL_RESISTED);
}
