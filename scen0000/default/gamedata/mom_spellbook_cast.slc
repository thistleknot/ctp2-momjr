                                if (auraUnit.type == UnitDB(UNIT_SERENA)) { bestAtk = 40; }
                            }
                        }
                    }
                    // Magic-resistant units (50%)
                    if (bestAtk < 50) {
                        if (killUnit.type == UnitDB(UNIT_DWARF_RUNESMITH)) { bestAtk = 50; }
                        if (killUnit.type == UnitDB(UNIT_IRON_GOLEM)) { bestAtk = 50; }
                    }
                    // Hero self-save (35%)
                    if (bestAtk < 35) {
                        if (killUnit.type == UnitDB(UNIT_ARIEL)) { bestAtk = 35; }
                        if (killUnit.type == UnitDB(UNIT_SERENA)) { bestAtk = 35; }
                        if (killUnit.type == UnitDB(UNIT_FREYA)) { bestAtk = 35; }
                        if (killUnit.type == UnitDB(UNIT_ALORRA)) { bestAtk = 35; }
                        if (killUnit.type == UnitDB(UNIT_JAFAR)) { bestAtk = 35; }
                        if (killUnit.type == UnitDB(UNIT_RJAK)) { bestAtk = 35; }
                        if (killUnit.type == UnitDB(UNIT_MALLEUS)) { bestAtk = 35; }
                        if (killUnit.type == UnitDB(UNIT_TAURON)) { bestAtk = 35; }
                        if (killUnit.type == UnitDB(UNIT_WARRAX)) { bestAtk = 35; }
                    }
                    // Chaos entropy (25%)
                    if (bestAtk < 25) {
                        if (killUnit.type == UnitDB(UNIT_HELL_HOUNDS)) { bestAtk = 25; }
                        if (killUnit.type == UnitDB(UNIT_MINOTAUR)) { bestAtk = 25; }
                        if (killUnit.type == UnitDB(UNIT_GARGOYLE)) { bestAtk = 25; }
                        if (killUnit.type == UnitDB(UNIT_SALAMANDER)) { bestAtk = 25; }
                        if (killUnit.type == UnitDB(UNIT_INFERNAL_DEVICE)) { bestAtk = 25; }
                        if (killUnit.type == UnitDB(UNIT_HYDRA)) { bestAtk = 25; }
                        if (killUnit.type == UnitDB(UNIT_EFREET)) { bestAtk = 25; }
                        if (killUnit.type == UnitDB(UNIT_TAURON)) { bestAtk = 25; }
                        if (killUnit.type == UnitDB(UNIT_WARRAX)) { bestAtk = 25; }
                    }
                    // Lamp artifact: +15% additive
                    if (bestAtk > 0 && MomHasLamp[killUnit.owner] == 1) {
                        bestAtk = bestAtk + 15;
                    }
                    if (bestAtk > 95) { bestAtk = 95; }
                    // Roll against threshold (0 = no protection, spell always lands)
                    if (bestAtk > 0) {
                        roll = Random(100);
                        if (roll < bestAtk) { resisted = 1; }
                    }
                    if (resisted == 0) {
                        KillUnit(killUnit);
                    } else {
                        Message(p, 'MomSpellResisted');
                    }
                    ki = cellCount;
                }
            }
            Message(p, 'MomSpellCast');
        } elseif (tgtFound == 1) {
            MomMagicCur[p] = MomMagicCur[p] - 100;
            Message(p, 'MomNoRequiredUnit');
        } else {
            Message(p, 'MomNoTargetInRange');
        }
    } elseif (spellId == 109) {
        // Demon Lord (summon) - cost 180
        MomMagicCur[p] = MomMagicCur[p] - 180;
        GetCityByIndex(p, 0, tmpCity);
        CreateUnit(p, UnitDB(UNIT_DEMON), tmpCity.location, 0);
        Message(p, 'MomSpellCast');
    } elseif (spellId == 110) {
        // Eternal Night (global_enchant) - cost 180
        MomMagicCur[p] = MomMagicCur[p] - 180;
        for (pi = 1; pi < 6; pi = pi + 1) {
            if (pi != p) {
                MomMagicCur[pi] = MomMagicCur[pi] - 20;
                if (MomMagicCur[pi] < 0) { MomMagicCur[pi] = 0; }
            }
        }
        Message(p, 'MomSpellCast');
    } elseif (spellId == 111) {
        // Evil Omens (global_enchant) - cost 180
        MomMagicCur[p] = MomMagicCur[p] - 180;
