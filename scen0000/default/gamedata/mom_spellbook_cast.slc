        CreateUnit(p, UnitDB(UNIT_EFREET), tmpCity.location, 0);
        Message(p, 'MomSpellCast');
    } elseif (spellId == 126) {
        // Fire Storm (instant_damage) - cost 37
        // BOUND to UNIT_EFREET (range 2)
        boundFound = 0;
        if (tgtFound == 1) {
            for (uIdx = 0; uIdx < numUnits; uIdx = uIdx + 1) {
                GetUnitByIndex(p, uIdx, scanUnit);
                if (scanUnit.type == UnitDB(UNIT_EFREET)) {
                    if (Distance(scanUnit.location, tgtLoc) <= 2) {
                        boundFound = 1;
                    }
                }
            }
        }
        if (boundFound == 1) {
            MomMagicCur[p] = MomMagicCur[p] - 37;
            CreateUnit(p, UnitDB(UNIT_HELL_HOUNDS), tgtLoc, 0);
            Message(p, 'MomSpellCast');
        } elseif (tgtFound == 1) {
            MomMagicCur[p] = MomMagicCur[p] - 37;
            Message(p, 'MomNoRequiredUnit');
        } else {
            Message(p, 'MomNoTargetInRange');
        }
    } elseif (spellId == 127) {
        // Armageddon (global_enchant) - cost 180
        MomMagicCur[p] = MomMagicCur[p] - 180;
        for (pi = 1; pi < 6; pi = pi + 1) {
            if (pi != p) {
                MomMagicCur[pi] = MomMagicCur[pi] - 30;
                if (MomMagicCur[pi] < 0) { MomMagicCur[pi] = 0; }
            }
        }
        Message(p, 'MomSpellCast');
    } elseif (spellId == 128) {
        // Call the Void (instant_damage) - cost 100
        // BOUND to UNIT_GREAT_WYRM (range 2)
        boundFound = 0;
        if (tgtFound == 1) {
            for (uIdx = 0; uIdx < numUnits; uIdx = uIdx + 1) {
                GetUnitByIndex(p, uIdx, scanUnit);
                if (scanUnit.type == UnitDB(UNIT_GREAT_WYRM)) {
                    if (Distance(scanUnit.location, tgtLoc) <= 2) {
                        boundFound = 1;
                    }
                }
            }
        }
        if (boundFound == 1) {
            MomMagicCur[p] = MomMagicCur[p] - 100;
            cellCount = GetUnitsAtLocation(tgtLoc);
            killCount = 0;
            for (ki = 0; ki < cellCount; ki = ki + 1) {
                GetUnitFromCell(tgtLoc, ki, killUnit);
                if (killUnit.owner != p && killCount == 0) {
                    resisted = 0;
                    bestAtk = 0;
                    // Elite opposing affinity (80%)
                    if (killUnit.type == UnitDB(UNIT_STORM_DRAKE)) { bestAtk = 80; }
                    if (killUnit.type == UnitDB(UNIT_AIR_ELEMENTAL)) { bestAtk = 80; }
                    if (killUnit.type == UnitDB(UNIT_WARLOCK)) { bestAtk = 80; }
                    // Strong aura: opposing elite on same tile (60%)
                    if (bestAtk < 60) {
                        auraCount = GetUnitsAtLocation(tgtLoc);
                        for (ai = 0; ai < auraCount; ai = ai + 1) {
                            GetUnitFromCell(tgtLoc, ai, auraUnit);
                            if (auraUnit.owner == killUnit.owner) {
                                if (auraUnit.type == UnitDB(UNIT_STORM_DRAKE)) { bestAtk = 60; }
                                if (auraUnit.type == UnitDB(UNIT_WARLOCK)) { bestAtk = 60; }
                            }
                        }
                    }
                    // Moderate aura: opposing common on tile (40%)
                    if (bestAtk < 40) {
                        auraCount = GetUnitsAtLocation(tgtLoc);
                        for (ai = 0; ai < auraCount; ai = ai + 1) {
                            GetUnitFromCell(tgtLoc, ai, auraUnit);
                            if (auraUnit.owner == killUnit.owner) {
                                if (auraUnit.type == UnitDB(UNIT_MAGE)) { bestAtk = 40; }
                                if (auraUnit.type == UnitDB(UNIT_JAFAR)) { bestAtk = 40; }
                                if (auraUnit.type == UnitDB(UNIT_STORM_GIANT)) { bestAtk = 40; }
                            }
                        }
                    }
                    // Magic-resistant units (50%)
                    if (bestAtk < 50) {
                        if (killUnit.type == UnitDB(UNIT_DWARF_RUNESMITH)) { bestAtk = 50; }
                        if (killUnit.type == UnitDB(UNIT_IRON_GOLEM)) { bestAtk = 50; }
                    }
                    // Hero self-save (35%)
                    if (bestAtk < 35) {
                        if (killUnit.type == UnitDB(UNIT_ARIEL)) { bestAtk = 35; }
                        if (killUnit.type == UnitDB(UNIT_SERENA)) { bestAtk = 35; }
                        if (killUnit.type == UnitDB(UNIT_FREYA)) { bestAtk = 35; }
                        if (killUnit.type == UnitDB(UNIT_ALORRA)) { bestAtk = 35; }
                        if (killUnit.type == UnitDB(UNIT_JAFAR)) { bestAtk = 35; }
                        if (killUnit.type == UnitDB(UNIT_RJAK)) { bestAtk = 35; }
                        if (killUnit.type == UnitDB(UNIT_MALLEUS)) { bestAtk = 35; }
                        if (killUnit.type == UnitDB(UNIT_TAURON)) { bestAtk = 35; }
                        if (killUnit.type == UnitDB(UNIT_WARRAX)) { bestAtk = 35; }
                    }
                    // Chaos entropy (25%)
                    if (bestAtk < 25) {
                        if (killUnit.type == UnitDB(UNIT_HELL_HOUNDS)) { bestAtk = 25; }
                        if (killUnit.type == UnitDB(UNIT_MINOTAUR)) { bestAtk = 25; }
                        if (killUnit.type == UnitDB(UNIT_GARGOYLE)) { bestAtk = 25; }
                        if (killUnit.type == UnitDB(UNIT_SALAMANDER)) { bestAtk = 25; }
                        if (killUnit.type == UnitDB(UNIT_INFERNAL_DEVICE)) { bestAtk = 25; }
                        if (killUnit.type == UnitDB(UNIT_HYDRA)) { bestAtk = 25; }
                        if (killUnit.type == UnitDB(UNIT_EFREET)) { bestAtk = 25; }
                        if (killUnit.type == UnitDB(UNIT_TAURON)) { bestAtk = 25; }
                        if (killUnit.type == UnitDB(UNIT_WARRAX)) { bestAtk = 25; }
                    }
                    // Lamp artifact: +15% additive
                    if (bestAtk > 0 && MomHasLamp[killUnit.owner] == 1) {
                        bestAtk = bestAtk + 15;
                    }
                    if (bestAtk > 95) { bestAtk = 95; }
                    // Roll against threshold (0 = no protection, spell always lands)
                    if (bestAtk > 0) {
                        roll = Random(100);
                        if (roll < bestAtk) { resisted = 1; }
                    }
                    if (resisted == 0) {
                        KillUnit(killUnit);
                    }
                    killCount = 1;
                    ki = cellCount;
                }
            }
            cellCount = GetUnitsAtLocation(tgtLoc);
            for (ki = 0; ki < cellCount; ki = ki + 1) {
                GetUnitFromCell(tgtLoc, ki, killUnit);
                if (killUnit.owner != p && killCount == 1) {
                    resisted = 0;
                    bestAtk = 0;
                    // Elite opposing affinity (80%)
                    if (killUnit.type == UnitDB(UNIT_STORM_DRAKE)) { bestAtk = 80; }
                    if (killUnit.type == UnitDB(UNIT_AIR_ELEMENTAL)) { bestAtk = 80; }
                    if (killUnit.type == UnitDB(UNIT_WARLOCK)) { bestAtk = 80; }
                    // Strong aura: opposing elite on same tile (60%)
                    if (bestAtk < 60) {
                        auraCount = GetUnitsAtLocation(tgtLoc);
                        for (ai = 0; ai < auraCount; ai = ai + 1) {
                            GetUnitFromCell(tgtLoc, ai, auraUnit);
                            if (auraUnit.owner == killUnit.owner) {
                                if (auraUnit.type == UnitDB(UNIT_STORM_DRAKE)) { bestAtk = 60; }
                                if (auraUnit.type == UnitDB(UNIT_WARLOCK)) { bestAtk = 60; }
                            }
                        }
                    }
                    // Moderate aura: opposing common on tile (40%)
                    if (bestAtk < 40) {
                        auraCount = GetUnitsAtLocation(tgtLoc);
                        for (ai = 0; ai < auraCount; ai = ai + 1) {
                            GetUnitFromCell(tgtLoc, ai, auraUnit);
                            if (auraUnit.owner == killUnit.owner) {
                                if (auraUnit.type == UnitDB(UNIT_MAGE)) { bestAtk = 40; }
                                if (auraUnit.type == UnitDB(UNIT_JAFAR)) { bestAtk = 40; }
                                if (auraUnit.type == UnitDB(UNIT_STORM_GIANT)) { bestAtk = 40; }
                            }
                        }
                    }
                    // Magic-resistant units (50%)
                    if (bestAtk < 50) {
                        if (killUnit.type == UnitDB(UNIT_DWARF_RUNESMITH)) { bestAtk = 50; }
                        if (killUnit.type == UnitDB(UNIT_IRON_GOLEM)) { bestAtk = 50; }
                    }
                    // Hero self-save (35%)
                    if (bestAtk < 35) {
                        if (killUnit.type == UnitDB(UNIT_ARIEL)) { bestAtk = 35; }
                        if (killUnit.type == UnitDB(UNIT_SERENA)) { bestAtk = 35; }
                        if (killUnit.type == UnitDB(UNIT_FREYA)) { bestAtk = 35; }
                        if (killUnit.type == UnitDB(UNIT_ALORRA)) { bestAtk = 35; }
                        if (killUnit.type == UnitDB(UNIT_JAFAR)) { bestAtk = 35; }
                        if (killUnit.type == UnitDB(UNIT_RJAK)) { bestAtk = 35; }
                        if (killUnit.type == UnitDB(UNIT_MALLEUS)) { bestAtk = 35; }
                        if (killUnit.type == UnitDB(UNIT_TAURON)) { bestAtk = 35; }
                        if (killUnit.type == UnitDB(UNIT_WARRAX)) { bestAtk = 35; }
                    }
                    // Chaos entropy (25%)
                    if (bestAtk < 25) {
                        if (killUnit.type == UnitDB(UNIT_HELL_HOUNDS)) { bestAtk = 25; }
                        if (killUnit.type == UnitDB(UNIT_MINOTAUR)) { bestAtk = 25; }
                        if (killUnit.type == UnitDB(UNIT_GARGOYLE)) { bestAtk = 25; }
                        if (killUnit.type == UnitDB(UNIT_SALAMANDER)) { bestAtk = 25; }
                        if (killUnit.type == UnitDB(UNIT_INFERNAL_DEVICE)) { bestAtk = 25; }
                        if (killUnit.type == UnitDB(UNIT_HYDRA)) { bestAtk = 25; }
                        if (killUnit.type == UnitDB(UNIT_EFREET)) { bestAtk = 25; }
                        if (killUnit.type == UnitDB(UNIT_TAURON)) { bestAtk = 25; }
                        if (killUnit.type == UnitDB(UNIT_WARRAX)) { bestAtk = 25; }
                    }
                    // Lamp artifact: +15% additive
                    if (bestAtk > 0 && MomHasLamp[killUnit.owner] == 1) {
                        bestAtk = bestAtk + 15;
                    }
                    if (bestAtk > 95) { bestAtk = 95; }
                    // Roll against threshold (0 = no protection, spell always lands)
                    if (bestAtk > 0) {
                        roll = Random(100);
                        if (roll < bestAtk) { resisted = 1; }
                    }
                    if (resisted == 0) {
                        KillUnit(killUnit);
                    }
                    killCount = 2;
                    ki = cellCount;
                }
            }
            Message(p, 'MomSpellCast');
        } elseif (tgtFound == 1) {
            MomMagicCur[p] = MomMagicCur[p] - 100;
            Message(p, 'MomNoRequiredUnit');
        } else {
            Message(p, 'MomNoTargetInRange');
        }
    } elseif (spellId == 129) {
        // Chaos Surge (global_enchant) - cost 180
        MomMagicCur[p] = MomMagicCur[p] - 180;
        GetCityByIndex(p, 0, tmpCity);
        CreateUnit(p, UnitDB(UNIT_HELL_HOUNDS), tmpCity.location, 0);
        Message(p, 'MomSpellCast');
    } elseif (spellId == 130) {
        // Doom Mastery (global_enchant) - cost 180
        MomMagicCur[p] = MomMagicCur[p] - 180;
        GetCityByIndex(p, 0, tmpCity);
        CreateUnit(p, UnitDB(UNIT_GARGOYLE), tmpCity.location, 0);
