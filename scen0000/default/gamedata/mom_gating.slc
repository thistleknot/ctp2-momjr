        || theUnit == UnitDB(UNIT_TREANT)
        || theUnit == UnitDB(UNIT_WARBEARS)
        || theUnit == UnitDB(UNIT_WAR_MAMMOTH)
        || theUnit == UnitDB(UNIT_WAR_TROLL)
        || theUnit == UnitDB(UNIT_WYVERN)
        ) { return 0; }
    }
    // SORCERY -- 10 block(s)
    if (MomSphere[theCity.owner] != 3) {
        if (theUnit == UnitDB(UNIT_AIR_ELEMENTAL)
        || theUnit == UnitDB(UNIT_APPRENTICE)
        || theUnit == UnitDB(UNIT_CRYSTAL_GOLEM)
        || theUnit == UnitDB(UNIT_DJINN)
        || theUnit == UnitDB(UNIT_JAFAR)
        || theUnit == UnitDB(UNIT_MAGE)
        || theUnit == UnitDB(UNIT_PHANTOM_WARRIORS)
        || theUnit == UnitDB(UNIT_STORM_DRAKE)
        || theUnit == UnitDB(UNIT_STORM_GIANT)
        || theUnit == UnitDB(UNIT_WARLOCK)
        ) { return 0; }
    }
    // DEATH -- 13 block(s)
    if (MomSphere[theCity.owner] != 4) {
        if (theUnit == UnitDB(UNIT_BONE_GOLEM)
        || theUnit == UnitDB(UNIT_DEATH_KNIGHT)
        || theUnit == UnitDB(UNIT_DEMON)
        || theUnit == UnitDB(UNIT_DRACOLICH)
        || theUnit == UnitDB(UNIT_LICH)
        || theUnit == UnitDB(UNIT_MALLEUS)
        || theUnit == UnitDB(UNIT_MINION)
        || theUnit == UnitDB(UNIT_RJAK)
        || theUnit == UnitDB(UNIT_SKELETONS)
        || theUnit == UnitDB(UNIT_UNDEAD_DRAGON)
        || theUnit == UnitDB(UNIT_VAMPIRE)
        || theUnit == UnitDB(UNIT_WRAITH)
        || theUnit == UnitDB(UNIT_ZOMBIES)
        ) { return 0; }
    }
    // CHAOS -- 14 block(s)
    if (MomSphere[theCity.owner] != 5) {
        if (theUnit == UnitDB(UNIT_DROW)
        || theUnit == UnitDB(UNIT_EFREET)
