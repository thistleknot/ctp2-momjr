        || theUnit == UnitDB(UNIT_UNICORN)
        ) { return 0; }
    }
    // NATURE -- 15 block(s)
    if (MomSphere[theCity.owner] != 2) {
        if (theUnit == UnitDB(UNIT_ALORRA)
