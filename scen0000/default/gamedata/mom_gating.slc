int_f mod_CanPlayerHaveAdvance(int_t thePlayer, int_t theAdvance)
{
    // Barbarians and any out-of-range player are unrestricted.
    if (MomSphere[g.player] < 1) { return 1; }
    // LIFE -- 6 block(s)
    if (MomSphere[g.player] != 1) {
        if (theAdvance == AdvanceDB(ADVANCE_LIFE_MAGIC)
        || theAdvance == AdvanceDB(ADVANCE_LIFE_LORE)
        || theAdvance == AdvanceDB(ADVANCE_LIFE_ADEPT)
        || theAdvance == AdvanceDB(ADVANCE_LIFE_MAGE)
        || theAdvance == AdvanceDB(ADVANCE_LIFE_WIZARD)
        || theAdvance == AdvanceDB(ADVANCE_LIFE_MASTER)
        ) { return 0; }
    }
    // NATURE -- 6 block(s)
    if (MomSphere[g.player] != 2) {
        if (theAdvance == AdvanceDB(ADVANCE_NATURE_MAGIC)
        || theAdvance == AdvanceDB(ADVANCE_NATURE_LORE)
        || theAdvance == AdvanceDB(ADVANCE_NATURE_ADEPT)
        || theAdvance == AdvanceDB(ADVANCE_NATURE_MAGE)
        || theAdvance == AdvanceDB(ADVANCE_NATURE_WIZARD)
        || theAdvance == AdvanceDB(ADVANCE_NATURE_MASTER)
        ) { return 0; }
    }
    // SORCERY -- 6 block(s)
    if (MomSphere[g.player] != 3) {
        if (theAdvance == AdvanceDB(ADVANCE_SORCERY)
        || theAdvance == AdvanceDB(ADVANCE_SORCEROUS_LORE)
        || theAdvance == AdvanceDB(ADVANCE_SORCERY_ADEPT)
        || theAdvance == AdvanceDB(ADVANCE_SORCERY_MAGE)
        || theAdvance == AdvanceDB(ADVANCE_SORCERY_WIZARD)
        || theAdvance == AdvanceDB(ADVANCE_SORCERY_MASTER)
        ) { return 0; }
    }
    // DEATH -- 6 block(s)
    if (MomSphere[g.player] != 4) {
        if (theAdvance == AdvanceDB(ADVANCE_DEATH_MAGIC)
        || theAdvance == AdvanceDB(ADVANCE_DEATH_LORE)
        || theAdvance == AdvanceDB(ADVANCE_DEATH_ADEPT)
        || theAdvance == AdvanceDB(ADVANCE_DEATH_MAGE)
        || theAdvance == AdvanceDB(ADVANCE_DEATH_WIZARD)
        || theAdvance == AdvanceDB(ADVANCE_DEATH_MASTER)
        ) { return 0; }
    }
    // CHAOS -- 6 block(s)
    if (MomSphere[g.player] != 5) {
        if (theAdvance == AdvanceDB(ADVANCE_CHAOS_MAGIC)
        || theAdvance == AdvanceDB(ADVANCE_CHAOS_LORE)
        || theAdvance == AdvanceDB(ADVANCE_CHAOS_ADEPT)
        || theAdvance == AdvanceDB(ADVANCE_CHAOS_MAGE)
        || theAdvance == AdvanceDB(ADVANCE_CHAOS_WIZARD)
        || theAdvance == AdvanceDB(ADVANCE_CHAOS_MASTER)
        ) { return 0; }
    }
    return 1;
}

int_f mod_CanCityBuildUnit(city_t theCity, int_t theUnit)
{
    // VESSELS -- 1, never buildable by anyone
    if (theUnit == UnitDB(UNIT_LAMP)
    ) { return 0; }
    // DWARVES -- terrain-gated: hill/mountain cities only
    if (theUnit == UnitDB(UNIT_DWARF_WARRIOR)
    || theUnit == UnitDB(UNIT_DWARF_CROSSBOW)
    || theUnit == UnitDB(UNIT_DWARF_RUNESMITH)
    ) {
        if (TerrainType(theCity.location) != 8
        && TerrainType(theCity.location) != 9
        && TerrainType(theCity.location) != 18
        && TerrainType(theCity.location) != 19
        && TerrainType(theCity.location) != 20
        && TerrainType(theCity.location) != 21
        ) { return 0; }
    }
    if (theCity.owner < 1 || theCity.owner > 5) { return 1; }
    // LIFE -- 10 block(s)
    if (MomSphere[theCity.owner] != 1) {
        if (theUnit == UnitDB(UNIT_ARCHANGEL)
        || theUnit == UnitDB(UNIT_ARIEL)
        || theUnit == UnitDB(UNIT_CRUSADER)
        || theUnit == UnitDB(UNIT_GUARDIAN_SPIRIT)
        || theUnit == UnitDB(UNIT_PALADINS)
