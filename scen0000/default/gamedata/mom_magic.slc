// MoM magic system (M1-M4) -- reconstructed from session log after H: FS corruption.
// #included LAST in scenario.slc, after mom_msg.slc. Base-verified SLIC only.
// M1 per-player magic-power pool, M2 school multipliers, M3 pool-overflow summon,
// M4 mana nodes. Popup uses base-verified {scalar} interpolation (NOT {Arr[Idx]}).
// NOTE: includes the sphere-guard crash fix (p < 1 return) that was in progress when
// the filesystem corrupted -- the turn-10 crash was this handler running for player 0.

// (magic power declarations live in mom_func.slc -- loaded first)

int_f MomRecalcMagicPerTurn(int_t mp_1)
{
    int_t i;
    int_t j;
    int_t gen;
    int_t pct;
    int_t nodes;
    city_t tmpCity;
    location_t cloc;
    location_t nloc;

    gen = 10;
    nodes = 0;
    // NEVER player[mp_1]: player[N] indexes the event ARG array (size 1), so mp_1>=1
    // throws "Array index 1 out of bounds". The turn player is player[0].
    for (i = 0; i < player[0].cities; i = i + 1) {
        GetCityByIndex(player[0], i, tmpCity);
        if (CityIsValid(tmpCity)) {
            gen = gen + tmpCity.population * 2;
            // M4 mana nodes: good-bearing tiles in the city inner radius (center + 8 neighbors).
            cloc = tmpCity.location;
            if (HasGood(cloc) >= 0) {
                nodes = nodes + 1;
            }
            for (j = 0; j < 8; j = j + 1) {
                GetNeighbor(cloc, j, nloc);
                if (HasGood(nloc) >= 0) {
                    nodes = nodes + 1;
                }
            }
        }
    }
    gen = gen + nodes * 5;   // MANA_NODE_BONUS = 5 per node, before school scaling
    pct = MomMagicSchoolPct[mp_1];
    if (pct == 0) {
        pct = 100;
    }
    gen = gen * pct / 100;
    return gen;
}

// M3: the creature a player's sphere summons on pool overflow (reuses the blessing units).
int_f MomSphereSummonUnit(int_t mp_2)
{
    // FLATTENED 2026-07-25. This is called FROM the MomMagicPoolTick handler
    // body, so calling MomPlayerIsLife() here made a 2-level user-function
    // chain -- the documented 0xC0000005 class. MEASURED: gating the caller
    // (the pool-overflow block) took the run from 7/25 to 14/25, and this is
    // the only 2-level chain in that handler (MomRecalcMagicPerTurn calls
    // builtins only), and it fires exactly when the pool first caps -- which
    // is why the crash tracked the cap turn and moved when unrelated code
    // changed the accrual. MomPlayerIsX(p) is literally p == N, so comparing
    // numerically is semantically identical at zero call depth.
    if (mp_2 == 1) {
        return UnitDB(UNIT_GUARDIAN_SPIRIT);
    }
    if (mp_2 == 2) {
        return UnitDB(UNIT_WARBEARS);
    }
    if (mp_2 == 3) {
        return UnitDB(UNIT_MAGE);
    }
    if (mp_2 == 4) {
        return UnitDB(UNIT_ZOMBIES);
    }
    if (mp_2 == 5) {
        return UnitDB(UNIT_HELL_HOUNDS);
    }
    return 0;
}

HandleEvent(BeginTurn) 'MomMagicPoolTick' post {
    int_t p;
    int_t r;
    int_t summon;

    p = player[0];

    // CRASH FIX (turn-10): magic is for sphere players 1..5 only. Player 0 (barbarians) and
    // any non-sphere player must skip. SLIC 'post' handlers cannot bare-return, so gate the
    // whole body with an if (this handler running for player 0 was the turn-10 crash).
    if (p >= 1) {
        if (MomMagicMax[p] == 0) {
            MomMagicMax[p] = 100;
        }

        MomMagicPerTurn[p] = MomRecalcMagicPerTurn(p);
        MomMagicCur[p] = MomMagicCur[p] + MomMagicPerTurn[p];
        if (MomMagicCur[p] > MomMagicMax[p]) {
            MomMagicCur[p] = MomMagicMax[p];
        }

        // M3 pool-overflow auto-summon: when the pool caps, discharge into the sphere creature.
        if (MomMagicMax[p] > 0 && MomMagicCur[p] >= MomMagicMax[p]) {
            summon = MomSphereSummonUnit(p);
            if (summon != 0 && player[0].cities > 0) {
                MomMagicCur[p] = 0;
                MomSpawnSphereUnit(p, summon);
            }
        }

        // Refresh the display scalars EVERY turn so the 'j' magic menu
        // (alertbox 'MagicMenu') always shows current values, not just on
        // the 10-round popup cadence below.
        if (IsHumanPlayer(p)) {
            MomMagicCurDisp = MomMagicCur[p];
            MomMagicMaxDisp = MomMagicMax[p];
            MomMagicGenDisp = MomMagicPerTurn[p];
        }

        // Periodic popup every 10 rounds (0,10,20,...). Latch prevents same-round re-fire flood.
        if (IsHumanPlayer(p)) {
            r = GetCurrentRound();
            if (r - (r / 10) * 10 == 0) {
                if (MomMagicShownTurn[p] != r + 1) {
                    MomMagicShownTurn[p] = r + 1;
                    MomMagicCurDisp = MomMagicCur[p];
                    MomMagicMaxDisp = MomMagicMax[p];
                    MomMagicGenDisp = MomMagicPerTurn[p];
                    Message(g.player, 'MomMagicPower');
                }
            }
        }
    }
}

// M2 school multipliers -- set the player's per-turn multiplier + pool cap on their sphere's
// magic advance. Separate named GrantAdvance handler (coexists with blessing handlers).
HandleEvent(GrantAdvance) 'MomMagicSchoolGrant' post {
    int_t p;
    int_t granted;

    p = player[0];
    granted = 0;

    // MEASURED 2026-07-25, twice. GrantAdvance does NOT populate advance[], so
    // reading advance[0].type is "Array index 0 out of bounds". The first fix
    // copied value[0] into advance[0] first (the idiom the sibling handler in
    // mom_city_effects.slc used) -- that ALSO errored, at the same line, which
    // falsified it: the assignment does not make advance[0] readable. The
    // granted advance IS value[0], an advance index, directly comparable to
    // AdvanceDB(). The advance[] array is not used at all now.
    if (value[0] != 0) {

    if (MomPlayerIsLife(p) && value[0] == AdvanceDB(ADVANCE_LIFE_MAGIC)) {
        MomMagicSchoolPct[p] = 100;
        MomMagicMax[p] = 200;
        granted = 1;
    } elseif (MomPlayerIsNature(p) && value[0] == AdvanceDB(ADVANCE_NATURE_MAGIC)) {
        MomMagicSchoolPct[p] = 110;
        MomMagicMax[p] = 220;
        granted = 1;
    } elseif (MomPlayerIsSorcery(p) && value[0] == AdvanceDB(ADVANCE_SORCERY)) {
        MomMagicSchoolPct[p] = 125;
        MomMagicMax[p] = 260;
        granted = 1;
    } elseif (MomPlayerIsDeath(p) && value[0] == AdvanceDB(ADVANCE_DEATH_MAGIC)) {
        MomMagicSchoolPct[p] = 115;
        MomMagicMax[p] = 240;
        granted = 1;
    } elseif (MomPlayerIsChaos(p) && value[0] == AdvanceDB(ADVANCE_CHAOS_MAGIC)) {
        MomMagicSchoolPct[p] = 140;
        MomMagicMax[p] = 300;
        granted = 1;
    }

    if (granted && IsHumanPlayer(p)) {
        MomMagicPerTurn[p] = MomRecalcMagicPerTurn(p);
        MomMagicCurDisp = MomMagicCur[p];
        MomMagicMaxDisp = MomMagicMax[p];
        MomMagicGenDisp = MomMagicPerTurn[p];
        Message(g.player, 'MomMagicPower');
    }

    }   // advance[0] != 0
}
