void_f MomSpawnSphereUnit(int_t p, int_t unitType)
{
    city_t tmpCity;

    player[1] = p;
    if (player[1].cities) {
        GetCityByIndex(player[1], 0, tmpCity);
        if (CityIsValid(tmpCity)) {
            CreateUnit(p, unitType, tmpCity.location, 1);
        }
    }
}
