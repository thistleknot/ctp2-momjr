// ===== DEATH SPELLBOOK HUB =====
alertbox 'MomSpellHub_death' {
    Show();
    Text(ID_MOM_SPELLHUB_DEATH);

    Button(ID_MOM_SPELL_CLOSE) {
        Kill();
    }
    // Common (4 spells) -- requires rung >= 1
    Button(ID_MOM_SPELLHUB_BTN_COMMON) {
        Kill();
        if (MomSphereRung[player[0]] >= 1) {
            Message(player[0], 'MomSpell_death_COMMON_1');
        } else {
            Message(player[0], 'MomSpellLocked');
        }
    }
    // Uncommon (7 spells) -- requires rung >= 1
    Button(ID_MOM_SPELLHUB_BTN_UNCOMMON) {
        Kill();
        if (MomSphereRung[player[0]] >= 1 && MomSpellHandRarity[player[0]] >= 1) {
            Message(player[0], 'MomSpell_death_UNCOMMON_1');
        } else {
            Message(player[0], 'MomSpellLocked');
        }
    }
    // Rare (6 spells) -- requires rung >= 1
    Button(ID_MOM_SPELLHUB_BTN_RARE) {
        Kill();
        if (MomSphereRung[player[0]] >= 1 && MomSpellHandRarity[player[0]] >= 2) {
            Message(player[0], 'MomSpell_death_RARE_1');
        } else {
            Message(player[0], 'MomSpellLocked');
        }
    }
    // Very Rare (6 spells) -- requires rung >= 1
    Button(ID_MOM_SPELLHUB_BTN_VERY_RARE) {
        Kill();
        if (MomSphereRung[player[0]] >= 1 && MomSpellHandRarity[player[0]] >= 3) {
            Message(player[0], 'MomSpell_death_VERY_RARE_1');
        } else {
            Message(player[0], 'MomSpellLocked');
        }
    }
}

