H:\Program Files(x86)\Activision\Call To Power 2\Scenarios\mom>{"session_id":"ece7bf46-8181-44dc-a467-b8bd73e45062","transcript_path":"C:\\Users\\user\\.claude\\projects\\H--Program-Files-x86--Activision-Call-To-Power-2\\ece7bf46-8181-44dc-a467-b8bd73e45062.jsonl","cwd":"H:\\Program Files(x86)\\Activision\\Call To Power 2\\Scenarios\\mom","prompt_id":"2bb03346-241e-45a1-8614-47b17c14a663","permission_mode":"auto","effort":{"level":"low"},"hook_event_name":"PreToolUse","tool_name":"Edit","tool_input":{"file_path":"H:\\Program Files(x86)\\Activision\\Call To Power 2\\Scenarios\\mom\\tools\\ctp2_generator.py","old_string":"# Same mapping for BUILDING prereqs. advance_code_map.csv carries two lanes and\n# the codes are NOT interchangeable: 'Eco' exists only in the prereq lane, so\n# reading buildings through MOM_UNIT_ADVANCE silently dropped them to the\n# WARRIOR_CODE fallback (found 2026-07-26 via Merchant's Guild). Unit lane is\n# kept as the base so a building can still borrow a unit-only code.\nMOM_PREREQ_ADVANCE = dict(MOM_UNIT_ADVANCE)\nMOM_PREREQ_ADVANCE.update(\n    {r[\"code\"]: r[\"advance\"] for r in _ADVANCE_CODE_ROWS if r[\"lane\"] == \"prereq\"}\n)\n","new_string":"# The BUILDING-prereq lane of the same control plane. Kept SEPARATE from the\n# unit lane rather than merged over it: the two lanes disagree on purpose\n# (unit 'MT' -> ADVANCE_THEOLOGY, prereq 'MT' -> ADVANCE_COMMUNE_WITH_GODS) and\n# 5 prereq-lane targets are dangling, so consumers must try this lane first and\n# FALL THROUGH to the unit lane when the target does not exist or is disabled.\n# Reading buildings through the unit lane alone silently dropped prereq-only\n# codes to the fallback advance (found 2026-07-26 via Merchant's Guild, 'Eco').\nMOM_PREREQ_ADVANCE_LANE = {\n    r[\"code\"]: r[\"advance\"] for r in _ADVANCE_CODE_ROWS if r[\"lane\"] == \"prereq\"\n}\n","replace_all":false},"tool_use_id":"toolu_01CYvsL6HX2WPWgnAWRQ781C"}

